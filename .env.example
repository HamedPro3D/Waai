# Copia este archivo a ".env" y completa los valores reales.

# Base de datos
# Ruta del archivo de base de datos usado por el backend Next.js.
DATABASE_PATH=./data/bot.db

# OpenRouter
# Crea tu cuenta gratis en https://openrouter.ai/ y genera una API key en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-tu-api-key-aqui

# Modelo gratuito por defecto (se puede cambiar desde el panel)
DEFAULT_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Evolution API Whatsapp
# En el futuro se tendra con el docker.compose
EVOLUTION_API_URL=http://localhost:8080

# Debe coincidir con AUTHENTICATION_API_KEY que le pasamos a Evolution API en el docker-compose (o en el .env).
EVOLUTION_API_KEY=change-me

# Nombre de la instancia de WhatsApp que crees en el Manager de Evolution API
# (http://localhost:8080/manager). Debe ser el mismo en ambos lados.
EVOLUTION_INSTANCE_NAME=Waai

# Solo para docker-compose (Postgres interno de Evolution API)
POSTGRES_PASSWORD=evolution_pg_password
